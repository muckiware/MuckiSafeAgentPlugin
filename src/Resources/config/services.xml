<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
                               http://symfony.com/schema/dic/services/services-1.0.xsd">
    <parameters>
        <!-- Global flat wakeup directory inside the app/scheduler containers (implementation plan 2.9). -->
        <parameter key="muwa_agent.wakeup_directory">/var/run/mucki-agent/wakeup</parameter>
    </parameters>

    <services>
        <service id="MuckiSafeAgentPlugin\Service\Plugin\FacilityDependencyGuard" public="true">
            <argument type="service" id="plugin.repository"/>
        </service>

        <service id="MuckiSafeAgentPlugin\Service\Secret\EncryptionKeyProvider" public="true">
            <argument>%env(string:MUWA_AGENT_ENCRYPTION_KEYRING)%</argument>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Secret\SecretWriteGuard" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Secret\SecretCipher" public="true">
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\EncryptionKeyProvider"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Secret\AgentProvisioner" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\SecretCipher"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\SecretWriteGuard"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\EncryptionKeyProvider"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Secret\AgentSecretRotator" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\SecretCipher"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\SecretWriteGuard"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\EncryptionKeyProvider"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Secret\MasterKeyReencryptor" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\SecretCipher"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\EncryptionKeyProvider"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\SecretWriteGuard"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Auth\RequestSignature"/>
        <service id="MuckiSafeAgentPlugin\Service\Auth\ResponseSignature"/>
        <service id="MuckiSafeAgentPlugin\Service\Auth\ReplayGuard">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Auth\AgentAuthenticator">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\SecretCipher"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Auth\ReplayGuard"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Auth\RequestSignature"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Subscriber\AgentAuthenticationSubscriber">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Auth\AgentAuthenticator"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Subscriber\AgentEntityWriteGuardSubscriber">
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Subscriber\AgentResponseSigningSubscriber">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Auth\ResponseSignature"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Protocol\StrictJsonObjectDecoder"/>
        <service id="MuckiSafeAgentPlugin\Service\Protocol\ProtocolSchemaValidator"/>
        <service id="MuckiSafeAgentPlugin\Service\Action\ActionDefinitionDecoder"/>
        <service id="MuckiSafeAgentPlugin\Service\Action\ActionValidator"/>
        <service id="MuckiSafeAgentPlugin\Service\Action\ParameterValidator"/>
        <service id="MuckiSafeAgentPlugin\Service\Job\JobClaimRequestDecoder">
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Protocol\StrictJsonObjectDecoder"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Protocol\ProtocolSchemaValidator"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Job\JobCreator" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Action\ActionDefinitionDecoder"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Action\ActionValidator"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Action\ParameterValidator"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Job\JobClaimer" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Job\JobLeaseRequestDecoder">
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Protocol\StrictJsonObjectDecoder"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Protocol\ProtocolSchemaValidator"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Job\JobTransitionGuard" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Job\JobStarter" public="true">
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobTransitionGuard"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Job\JobHeartbeat" public="true">
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobTransitionGuard"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Job\JobCompleteRequestDecoder">
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Protocol\StrictJsonObjectDecoder"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Protocol\ProtocolSchemaValidator"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Job\OutputTailNormalizer"/>
        <service id="MuckiSafeAgentPlugin\Service\Job\JobCompletion" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\OutputTailNormalizer"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobTransitionGuard"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Job\JobReaper" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Job\FailureTailPruner" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Wakeup\WakeupCleaner" public="true">
            <argument>%muwa_agent.wakeup_directory%</argument>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Wakeup\WakeupWriter" public="true">
            <argument>%muwa_agent.wakeup_directory%</argument>
            <argument type="service" id="Psr\Log\LoggerInterface"/>
        </service>
        <service id="MuckiSafeAgentPlugin\ScheduledTask\AgentCleanupTask">
            <tag name="shopware.scheduled.task"/>
        </service>
        <service id="MuckiSafeAgentPlugin\ScheduledTask\AgentCleanupTaskHandler" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobReaper"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Auth\ReplayGuard"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\FailureTailPruner"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Wakeup\WakeupCleaner"/>
            <tag name="messenger.message_handler" handles="MuckiSafeAgentPlugin\ScheduledTask\AgentCleanupTask"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Hook\LegacyHookConflictGuard" public="true">
            <!-- Facility's DAL repository; missing (Facility inactive) fails closed instead of breaking the container. -->
            <argument type="service" id="muwa_backup_repository.repository" on-invalid="null"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Hook\RepositoryHookConfigurator" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="muwa_agent_repository_hook.repository"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Hook\LegacyHookConflictGuard"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Plugin\FacilityDependencyGuard"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Job\JobWaiter" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobReaper"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Hook\HostAgentHookExecutor" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobCreator"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobWaiter"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Wakeup\WakeupWriter"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Hook\BackupRunCoordinator" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Hook\LegacyHookConflictGuard"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Hook\HostAgentHookExecutor"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Subscriber\FacilityBackupBeforeSubscriber" public="true">
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Hook\BackupRunCoordinator"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Subscriber\FacilityBackupAfterSubscriber" public="true">
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Hook\BackupRunCoordinator"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Subscriber\FacilityBackupFinishedSubscriber" public="true">
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Hook\BackupRunCoordinator"/>
            <tag name="kernel.event_subscriber"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Action\ActionConfigurator" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Action\ActionDefinitionDecoder"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Action\ActionValidator"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Controller\Admin\ActionController" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Action\ActionConfigurator"/>
            <tag name="controller.service_arguments"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Controller\Admin\RepositoryHookController" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Hook\RepositoryHookConfigurator"/>
            <tag name="controller.service_arguments"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Heartbeat\HostHeartbeatRequestDecoder">
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Protocol\StrictJsonObjectDecoder"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Protocol\ProtocolSchemaValidator"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Service\Heartbeat\HostHeartbeat" public="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Controller\Agent\HostHeartbeatController" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Heartbeat\HostHeartbeatRequestDecoder"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Heartbeat\HostHeartbeat"/>
            <tag name="controller.service_arguments"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Controller\Agent\JobClaimController" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobClaimRequestDecoder"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobClaimer"/>
            <tag name="controller.service_arguments"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Controller\Agent\JobStartController" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobLeaseRequestDecoder"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobStarter"/>
            <tag name="controller.service_arguments"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Controller\Agent\JobHeartbeatController" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobLeaseRequestDecoder"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobHeartbeat"/>
            <tag name="controller.service_arguments"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Controller\Agent\JobCompleteController" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobCompleteRequestDecoder"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Job\JobCompletion"/>
            <tag name="controller.service_arguments"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Controller\Admin\AgentProvisionController" public="true">
            <argument type="service" id="Psr\Log\LoggerInterface"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\AgentProvisioner"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\AgentSecretRotator"/>
            <argument type="service" id="MuckiSafeAgentPlugin\Service\Secret\MasterKeyReencryptor"/>
            <tag name="controller.service_arguments"/>
        </service>

        <service id="MuckiSafeAgentPlugin\Core\Content\AgentHost\AgentHostDefinition">
            <tag name="shopware.entity.definition" entity="muwa_agent_host"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Core\Content\AgentAction\AgentActionDefinition">
            <tag name="shopware.entity.definition" entity="muwa_agent_action"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Core\Content\AgentRepositoryHook\AgentRepositoryHookDefinition">
            <tag name="shopware.entity.definition" entity="muwa_agent_repository_hook"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Core\Content\AgentBackupRun\AgentBackupRunDefinition">
            <tag name="shopware.entity.definition" entity="muwa_agent_backup_run"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Core\Content\AgentJob\AgentJobDefinition">
            <tag name="shopware.entity.definition" entity="muwa_agent_job"/>
        </service>
        <service id="MuckiSafeAgentPlugin\Core\Content\AgentNonce\AgentNonceDefinition">
            <tag name="shopware.entity.definition" entity="muwa_agent_nonce"/>
        </service>
    </services>
</container>
