{% block muwa_agent_secret_modal %}
    <sw-modal
        class="muwa-agent-secret-modal"
        :title="title"
        :closable="false"
        variant="default"
    >
        <sw-alert variant="warning">
            {{ $t('muwa-agent.secret.onceWarning') }}
        </sw-alert>

        <sw-text-field
            :value="issued.name"
            :label="$t('muwa-agent.host.nameLabel')"
            disabled
        />

        <sw-text-field
            :value="issued.keyId"
            :label="$t('muwa-agent.secret.keyIdLabel')"
            :help-text="$t('muwa-agent.secret.keyIdHelp')"
            copyable
            readonly
        />

        <sw-text-field
            :value="issued.secret"
            :label="$t('muwa-agent.secret.secretLabel')"
            :help-text="$t('muwa-agent.secret.secretHelp')"
            copyable
            readonly
        />

        <sw-checkbox-field
            v-model:value="confirmedStored"
            :label="$t('muwa-agent.secret.confirmStored')"
        />

        <template #modal-footer>
            <sw-button
                size="small"
                variant="primary"
                :disabled="!confirmedStored"
                @click="$emit('close')"
            >
                {{ $t('muwa-agent.secret.done') }}
            </sw-button>
        </template>
    </sw-modal>
{% endblock %}
