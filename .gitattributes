# Exclude development-only paths from the plugin distribution archive
/.github export-ignore
/tests export-ignore
/agent export-ignore
/docs export-ignore
/examples export-ignore
/.gitignore export-ignore
/.gitattributes export-ignore
/phpunit.xml.dist export-ignore
/phpstan.neon export-ignore

# Normalize line endings for text files
*.php text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.go text eol=lf
*.service text eol=lf
