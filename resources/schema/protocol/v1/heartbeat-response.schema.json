{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:muwa:agent:protocol:v1:heartbeat-response",
  "title": "Host heartbeat response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "serverTime",
    "pollAfterSeconds"
  ],
  "properties": {
    "serverTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "pollAfterSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    }
  }
}
