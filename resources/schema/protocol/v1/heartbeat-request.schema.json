{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:muwa:agent:protocol:v1:heartbeat-request",
  "title": "Host heartbeat request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "agentVersion",
    "platform",
    "arch",
    "capabilities",
    "agentTime"
  ],
  "properties": {
    "agentVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$"
    },
    "platform": {
      "type": "string",
      "enum": [
        "linux"
      ]
    },
    "arch": {
      "type": "string",
      "enum": [
        "amd64",
        "arm64"
      ]
    },
    "capabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{0,63}$"
      }
    },
    "agentTime": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
