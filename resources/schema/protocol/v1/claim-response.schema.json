{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:muwa:agent:protocol:v1:claim-response",
  "title": "Job claim response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job"
  ],
  "properties": {
    "job": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "id",
        "claimToken",
        "leaseVersion",
        "leaseExpiresAt",
        "phaseDeadline",
        "executionDeadline",
        "stopDeadline",
        "phase",
        "idempotencyClass",
        "action",
        "parameters"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "claimToken": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "leaseVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "leaseExpiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "phaseDeadline": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "executionDeadline": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "stopDeadline": {
          "type": "string",
          "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "pre",
            "post",
            "finally"
          ]
        },
        "idempotencyClass": {
          "type": "string",
          "enum": [
            "safe",
            "non_retryable"
          ]
        },
        "action": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "definitionCanonical",
            "actionHash"
          ],
          "properties": {
            "definitionCanonical": {
              "type": "string",
              "minLength": 2,
              "maxLength": 65536
            },
            "actionHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "parameters": {
          "type": "object"
        }
      }
    }
  }
}
