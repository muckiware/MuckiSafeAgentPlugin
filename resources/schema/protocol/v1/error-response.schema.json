{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:muwa:agent:protocol:v1:error-response",
  "title": "Agent error response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "traceId"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^MUWA_AGENT_[A-Z][A-Z_]{0,63}$"
    },
    "message": {
      "type": "string",
      "maxLength": 1024
    },
    "traceId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
