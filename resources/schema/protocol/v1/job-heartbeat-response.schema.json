{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:muwa:agent:protocol:v1:job-heartbeat-response",
  "title": "Job lease heartbeat response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "leaseVersion",
    "leaseExpiresAt",
    "stopRequested"
  ],
  "properties": {
    "leaseVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "leaseExpiresAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    },
    "stopRequested": {
      "type": "boolean"
    },
    "stopDeadline": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$"
    }
  }
}
