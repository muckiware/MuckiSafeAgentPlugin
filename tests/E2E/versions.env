# Pinned versions of the Linux service E2E (Task 32), paired with
# tests/E2E/images.lock: every *_E2E_VERSION is the tag of the matching
# *_IMAGE there (checked by scripts/selftest.sh).
# Reference versions come from reachable public endpoints or the supplied
# reference Compose files. E2E versions are immutable selections for Gate B.

BITWARDEN_REFERENCE_VERSION=2026.10.1
JELLYFIN_REFERENCE_VERSION=12.4.0
IMMICH_REFERENCE_VERSION=3.3.5
PAPERLESS_REFERENCE_VERSION=3.1.3

BITWARDEN_MSSQL_E2E_VERSION=2022-CU18-ubuntu-22.04
IMMICH_POSTGRES_E2E_VERSION=14-vectorchord0.4.3-pgvectors0.2.0
IMMICH_SERVER_E2E_VERSION=v3.3.5
IMMICH_MACHINE_LEARNING_E2E_VERSION=v3.3.5
IMMICH_VALKEY_E2E_VERSION=9.0.0-alpine
PAPERLESS_MARIADB_E2E_VERSION=12.0.2
PAPERLESS_VALKEY_E2E_VERSION=9.0.0-alpine
PAPERLESS_WEBSERVER_E2E_VERSION=3.1.3
PAPERLESS_GOTENBERG_E2E_VERSION=8.34
PAPERLESS_TIKA_E2E_VERSION=3.3.1.0

# Harness of Task 32: TLS proxy and the MuckiSafe image the source mode
# extends with this plugin (v0.2.5 ships Facility 0.11.1, amd64 + arm64).
CADDY_E2E_VERSION=2.10.2-alpine
MUCKISAFE_BASE_E2E_VERSION=v0.2.5
# Commit of muckiware/MuckiSafe whose docker-compose.yml is the system under
# test (contains the wakeup mount and keyring of Task 30).
MUCKISAFE_COMPOSE_REF=dac2b3b326c051aee4485fcacbc117949cfa0796
