# Pinned native Jellyfin packages of the Linux service E2E (Task 32),
# sourced by tests/E2E/scenarios/jellyfin.sh. Kept apart from versions.env,
# whose selftest requires an images.lock entry for every *_E2E_VERSION:
# Jellyfin is a native systemd service, not a container.
#
# JELLYFIN_REFERENCE_VERSION=12.4.0 (versions.env) is what
# GET /System/Info/Public reports; the official Debian/Ubuntu packages of
# that release carry the version "12.4+ubu2404" (noble = Ubuntu 24.04, the
# runner OS). The packages are downloaded from the official pool by their
# exact file name and verified against the SHA256 below before dpkg sees
# them, so neither a repository key nor the mutable repository index is
# trusted at run time.
#
# Source of every value (read 2026-11-25):
#   https://repo.jellyfin.org/ubuntu/dists/noble/main/binary-amd64/Packages
#   https://repo.jellyfin.org/ubuntu/dists/noble/main/binary-arm64/Packages
# (stanzas jellyfin, jellyfin-server, jellyfin-web 12.4+ubu2404 and
# jellyfin-ffmpeg8 8.1.3-2-noble, the newest jellyfin-ffmpeg8 the jellyfin
# 12.4 metapackage depends on).

JELLYFIN_PACKAGE_BASE_URL=https://repo.jellyfin.org/ubuntu
JELLYFIN_PACKAGE_UBUNTU=24.04
JELLYFIN_PACKAGE_VERSION=12.4+ubu2404
JELLYFIN_FFMPEG_PACKAGE_VERSION=8.1.3-2-noble

# Architecture independent
JELLYFIN_META_DEB=pool/main/j/jellyfin/jellyfin_12.4+ubu2404_all.deb
JELLYFIN_META_SHA256=55cc935a3ec5a0f209984d0864dea6d2363ce601fc3fb7a90a0e463886a5c63e
JELLYFIN_WEB_DEB=pool/main/j/jellyfin/jellyfin-web_12.4+ubu2404_all.deb
JELLYFIN_WEB_SHA256=0da66acfc2da32490df576ed5fd9e95634dddfd5f1fd14dd735b31d1dcb7fcf7

# amd64
JELLYFIN_SERVER_DEB_AMD64=pool/main/j/jellyfin/jellyfin-server_12.4+ubu2404_amd64.deb
JELLYFIN_SERVER_SHA256_AMD64=88b9ff091677588686644d8da61c21c2e9fbd9bb99296b380e9c0efa8ec68285
JELLYFIN_FFMPEG_DEB_AMD64=pool/main/j/jellyfin-ffmpeg/jellyfin-ffmpeg8_8.1.3-2-noble_amd64.deb
JELLYFIN_FFMPEG_SHA256_AMD64=22e3bbb6ca67f4d7badb16ae4a3c677940b97cb76eb273af7d70f6cb2b9b62bf

# arm64
JELLYFIN_SERVER_DEB_ARM64=pool/main/j/jellyfin/jellyfin-server_12.4+ubu2404_arm64.deb
JELLYFIN_SERVER_SHA256_ARM64=7c8c601e13b910fc2604947fe3b177f753a1381dde2cae21750ecfb51f035baf
JELLYFIN_FFMPEG_DEB_ARM64=pool/main/j/jellyfin-ffmpeg/jellyfin-ffmpeg8_8.1.3-2-noble_arm64.deb
JELLYFIN_FFMPEG_SHA256_ARM64=feaf81775079ce08fd6c07a478b16562454c61e5ed4fb15e3bff762543d6f337
